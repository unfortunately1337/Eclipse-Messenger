# Local Compose settings. Never use these credentials in production.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
ALLOWED_ORIGINS="http://localhost:3000"

# npm run setup:local generates an independent random value for each secret.
# Back up long-lived encryption keys; replacing them requires migrating data.
SESSION_SECRET=""
CSRF_SECRET=""
EMAIL_CODE_SECRET=""
TOTP_ENCRYPTION_KEY=""
E2E_DB_ENCRYPTION_KEY=""
E2E_BACKUP_ENCRYPTION_KEY=""
MEDIA_ENCRYPTION_KEY=""

# Your own Pusher Channels application for realtime events.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Optional Pusher Beams push notifications.
PUSHER_BEAMS_INSTANCE_ID=""
PUSHER_BEAMS_SECRET_KEY=""
NEXT_PUBLIC_PUSHER_BEAMS_INSTANCE_ID=""

# Local MinIO; create the bucket in its console at http://localhost:9001.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="eclipse-media"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_USE_SSL="false"

# A working provider is required to deliver login/registration codes.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Eclipse <no-reply@example.com>"
SMTP_SECURE="false"
