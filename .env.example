# ==========================================
# ECLIPSE ENVIRONMENT VARIABLES
# ==========================================

# База данных PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@host:5432/eclipse?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
# Внешние адреса приложения без завершающего /, через запятую.
# Укажите production-домен, если reverse proxy заменяет Host внутренним адресом.
ALLOWED_ORIGINS="http://localhost:3000"

# Секреты сессий и токенов
SESSION_SECRET="your-32-character-session-secret-key"
CSRF_SECRET="your-32-character-csrf-secret-key"
EMAIL_CODE_SECRET="your-32-character-email-code-secret"
TOTP_ENCRYPTION_KEY="your-32-character-totp-key"

# Ключи шифрования E2E базы данных и медиа
E2E_DB_ENCRYPTION_KEY="your-32-byte-hex-or-base64-key"
E2E_BACKUP_ENCRYPTION_KEY="your-32-byte-backup-key"
MEDIA_ENCRYPTION_KEY="your-32-byte-media-encryption-key"

# Pusher Realtime (Сообщения и статусы)
PUSHER_APP_ID="your_pusher_app_id"
PUSHER_KEY="your_pusher_key"
PUSHER_SECRET="your_pusher_secret"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="your_pusher_key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Pusher Beams (Push-уведомления)
PUSHER_BEAMS_INSTANCE_ID="your_beams_instance_id"
PUSHER_BEAMS_SECRET_KEY="your_beams_secret_key"
NEXT_PUBLIC_PUSHER_BEAMS_INSTANCE_ID="your_beams_instance_id"

# Self-hosted SFU for group video chats (server-only; see deploy/livekit).
# Personal calls continue using the P2P transport below.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Personal calls use P2P with coturn fallback. Configure TURN before production.
# Switching affects new calls; existing calls retain their selected transport.
CALLS_DIRECT_TRANSPORT=p2p
WEBRTC_STUN_URLS="stun:eclpse.ru:3478"
WEBRTC_TURN_URLS="turn:eclpse.ru:3478?transport=udp,turn:eclpse.ru:3478?transport=tcp,turns:eclpse.ru:5349?transport=tcp"
# Same random secret as coturn static-auth-secret (48 random bytes recommended).
# Server only. Never prefix with NEXT_PUBLIC_ or send the shared secret to browsers.
WEBRTC_TURN_SECRET=""
WEBRTC_TURN_TTL_SECONDS=1800
# all = direct preferred, TURN fallback; relay = dedicated TURN-only verification.
WEBRTC_ICE_TRANSPORT_POLICY=all

# Хранилище медиафайлов (S3 / MinIO / Timeweb / Cloudflare R2 / AWS)
S3_ENDPOINT="https://s3.storage.example.com"
S3_REGION="us-east-1"
S3_BUCKET="eclipse-media"
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_FORCE_PATH_STYLE="true"
S3_USE_SSL="true"

# Почтовый сервер SMTP (Коды верификации и сброс паролей)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Eclipse"
SMTP_SECURE="false"

# Server-only Telegram Bot API credential for the account pack importer.
TELEGRAM_IMPORT_BOT_TOKEN=
TELEGRAM_IMPORT_WEBHOOK_SECRET=
# Development only: polling. Production always uses the same-domain webhook.
TELEGRAM_IMPORT_RECEIVER_MODE=webhook
