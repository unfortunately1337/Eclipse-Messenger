# Configure your own services. Replace all example connection settings.
DATABASE_URL="postgresql://eclipse:change-me@127.0.0.1:5432/eclipse?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
ALLOWED_ORIGINS="http://localhost:3000"

# npm run setup:local generates an independent random value for each secret.
# Back up long-lived encryption keys; replacing them requires migrating data.
SESSION_SECRET=""
CSRF_SECRET=""
EMAIL_CODE_SECRET=""
TOTP_ENCRYPTION_KEY=""
E2E_DB_ENCRYPTION_KEY=""
E2E_BACKUP_ENCRYPTION_KEY=""
MEDIA_ENCRYPTION_KEY=""

# Your own Pusher Channels application for realtime events.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Optional Pusher Beams push notifications.
PUSHER_BEAMS_INSTANCE_ID=""
PUSHER_BEAMS_SECRET_KEY=""
NEXT_PUBLIC_PUSHER_BEAMS_INSTANCE_ID=""

# Your S3-compatible provider; create a private bucket and its access credentials.
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="eclipse-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_USE_SSL="true"

# A working provider is required to deliver login/registration codes.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Eclipse <no-reply@example.com>"
SMTP_SECURE="false"

# Optional rollback only: add server-only LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET if explicitly switching personal calls back to LiveKit.

# Optional account sticker/emoji importer. Server only; provide your own bot.
TELEGRAM_IMPORT_BOT_TOKEN=""
TELEGRAM_IMPORT_WEBHOOK_SECRET=""
TELEGRAM_IMPORT_RECEIVER_MODE="webhook"

# Personal calls use P2P with coturn fallback. Configure TURN before production.
# Switching affects new calls; existing calls retain their selected transport.
CALLS_DIRECT_TRANSPORT=p2p
WEBRTC_STUN_URLS="stun:turn.example.com:3478"
WEBRTC_TURN_URLS="turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp"
# Same random secret as coturn static-auth-secret (48 random bytes recommended).
# Server only. Never prefix with NEXT_PUBLIC_ or send the shared secret to browsers.
WEBRTC_TURN_SECRET=""
WEBRTC_TURN_TTL_SECONDS=1800
# all = direct preferred, TURN fallback; relay = dedicated TURN-only verification.
WEBRTC_ICE_TRANSPORT_POLICY=all
