{
  "name": "eclipse",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:webpack": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "postinstall": "node scripts/patch-braces.cjs && prisma generate",
    "build": "node --max-old-space-size=2560 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js",
    "media:backfill": "node scripts/media-backfill.js",
    "e2e:migrate-at-rest": "node scripts/migrate-e2e-at-rest.js",
    "e2e:preflight": "node scripts/e2e-preflight-check.mjs",
    "e2e:rewrap-db-secrets": "node scripts/e2e-rewrap-db-secrets.mjs --apply",
    "e2e:reconcile-shared-holders": "node scripts/e2e-reconcile-shared-holders.mjs --apply",
    "e2e:repair-identities": "node scripts/e2e-repair-identities.mjs",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "predev": "node scripts/check-node-version.cjs && node scripts/ensure-prisma-client.cjs",
    "prebuild": "node scripts/check-node-version.cjs",
    "prestart": "node scripts/check-node-version.cjs && npm run db:migrate",
    "pretest": "node scripts/check-node-version.cjs",
    "setup:local": "node scripts/setup-local-env.cjs",
    "calls:smoke": "node scripts/test-calls-livekit.mjs",
    "calls:test-user": "node scripts/call-test-user.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/client-ses": "^3.1070.0",
    "@aws-sdk/client-sesv2": "^3.1070.0",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@marsidev/react-turnstile": "^1.4.2",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.43.0",
    "bullmq": "^5.79.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "framer-motion": "^12.34.1",
    "heic2any": "^0.0.4",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "lottie-web": "^5.12.2",
    "lucide-react": "^0.572.0",
    "music-metadata": "^12.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.13",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-useanimations": "^3.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "undici": "^7.30.0",
    "zod": "^4.1.12",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "emoji-datasource-apple": "^16.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.64.1",
    "prisma": "^6.19.3",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "license": "AGPL-3.0-only",
  "description": "Eclipse Messenger — conversations, communities and customization.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfortunately1337/Eclipse-Messenger.git"
  },
  "homepage": "https://eclpse.ru",
  "bugs": {
    "url": "https://github.com/unfortunately1337/Eclipse-Messenger/issues"
  }
}
